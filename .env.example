# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ============================================================================
# Server Tier Configuration (Node / Express Backend on port 3001)
# ============================================================================
PORT=3001
SESSION_SECRET="generate-a-strong-random-32-byte-hex-secret"

# ============================================================================
# PingCAP TiDB Cloud Configuration (Server-Side ONLY - Never use VITE_ prefix)
# Sign up free at https://tidbcloud.com (5 GiB free Serverless cluster)
# ============================================================================
# Gateway Host from TiDB Cloud Console -> Connect -> General
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com

# Standard TiDB MySQL wire port (4000)
TIDB_PORT=4000

# TiDB Cluster User (e.g. <cluster-prefix>.root)
TIDB_USER=

# TiDB Cluster Password
TIDB_PASSWORD=

# Target database name
TIDB_DATABASE=it_asset_ledger

# Enable TLS/SSL connection (required on port 4000)
TIDB_SSL=true
