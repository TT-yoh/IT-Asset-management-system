# ============================================================================
# OmniAsset Enterprise IT Asset Management - Environment Configuration
# ============================================================================
# Copy this file to .env and provide your deployment-specific configuration.
# Leave no placeholders in production. All credentials below are empty.
# ============================================================================

# Application Environment ('development', 'production', or 'test')
# In production, ensure NODE_ENV=production or launch via 'npm start'
NODE_ENV=development

# Server API Port (default: 3001)
PORT=3001

# Session Signing & Cookie Secret
# REQUIRED in production. Must be at least 32 characters long.
# Generate via: openssl rand -hex 32
SESSION_SECRET=

# PingCAP TiDB Cloud / MySQL Server Configuration (Server-Side ONLY)
# REQUIRED in production.
# TiDB Cloud Console -> Connect -> General
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=
TIDB_SSL=true

# Path to custom CA certificate file (Optional, e.g., /etc/ssl/certs/ca-certificates.crt)
TIDB_CA_PATH=

# Allowed CORS Origins (Comma-separated list of origins)
# REQUIRED in production (e.g., https://assets.example.com,https://admin.example.com)
# In development, defaults to localhost:3000, localhost:3001
CORS_ORIGINS=

# TOTP 2FA Encryption Key (AES-256-GCM symmetric key for encrypting TOTP secrets)
# REQUIRED in production. Must be exactly 32 bytes (64 hex characters or 32 raw bytes).
# Generate via: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Reverse Proxy Trust Setting (Optional)
# Set to 'true', '1', or specific proxy hop count if behind Cloudflare, Nginx, ALB, or Vercel
TRUST_PROXY=

# Route & Development Security Flags
# Set to 'true' only if legacy root endpoints (outside /api) must be mounted
ALLOW_ROOT_ROUTES=false

# Strictly require Idempotency-Key headers on all mutating POST/PUT/PATCH requests
IDEMPOTENCY_REQUIRED=false

# In-Memory Database Mode (Development & Automated Testing ONLY)
# Set to 'true' only during isolated unit tests without active TiDB network access
ALLOW_IN_MEMORY_DB=false

# SMTP Mail Delivery Settings (Optional: for password resets & 2FA invitation delivery)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Initial Bootstrap Administrator (Used ONLY by scripts/seed-super-admin.mjs and maintenance)
# Generate a strong password: openssl rand -base64 24
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ID=
ADMIN_NAME=
