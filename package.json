{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx server/index.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "build": "vite build && node scripts/verify-client-bundle.mjs && node scripts/build-server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist api/index.js",
    "test:stress": "cross-env NODE_ENV=test tsx tests/stress-test.ts",
    "lint": "tsc --noEmit",
    "test:config": "cross-env NODE_ENV=test tsx tests/config-validation.test.ts",
    "test:db": "cross-env NODE_ENV=test tsx tests/database-layer.test.ts",
    "test:security": "cross-env NODE_ENV=test tsx tests/security-scoping.test.ts",
    "test:audit": "cross-env NODE_ENV=test tsx tests/audit-integrity.test.ts",
    "test:concurrency": "cross-env NODE_ENV=test tsx tests/offline-concurrency.test.ts",
    "test:facilities": "cross-env NODE_ENV=test tsx tests/facilities-departments.test.ts",
    "test:auth": "cross-env NODE_ENV=test tsx tests/auth-hardening.test.ts",
    "test:e2e": "cross-env NODE_ENV=test tsx tests/e2e-system-functionality.test.ts",
    "test": "cross-env NODE_ENV=test tsx tests/config-validation.test.ts && cross-env NODE_ENV=test tsx tests/database-layer.test.ts && cross-env NODE_ENV=test tsx tests/security-scoping.test.ts && cross-env NODE_ENV=test tsx tests/audit-integrity.test.ts && cross-env NODE_ENV=test tsx tests/offline-concurrency.test.ts && cross-env NODE_ENV=test tsx tests/facilities-departments.test.ts && cross-env NODE_ENV=test tsx tests/auth-hardening.test.ts && cross-env NODE_ENV=test tsx tests/schema-drift.test.ts && cross-env NODE_ENV=test tsx tests/e2e-system-functionality.test.ts",
    "db:migrate:tidb": "node scripts/execute-tidb-schema.mjs",
    "db:clean": "node scripts/cleanup-dummy-data.mjs",
    "db:clean:idempotency": "node scripts/cleanup-idempotency.mjs",
    "test:drift": "cross-env NODE_ENV=test tsx tests/schema-drift.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:dry-run": "node scripts/migrate.mjs --dry-run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.5",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "three": "^0.185.0",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
