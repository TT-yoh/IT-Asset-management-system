# ============================================================================
# OmniAsset - TEST environment (used only when NODE_ENV=test, i.e. `npm test`)
# ============================================================================
# Copy to .env.test. Test processes read ONLY this file, never .env, and refuse to
# start if the database below is the production one (schema it_asset_ledger, or the
# same host + schema as .env). See docs/TESTING.md.
# ============================================================================

# Local TiDB in Docker (see docs/TESTING.md):
#   docker run -d --name omniasset-test-tidb -p 127.0.0.1:4001:4000 pingcap/tidb:v8.5.1
TIDB_HOST=127.0.0.1
TIDB_PORT=4001
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=it_asset_ledger_test
TIDB_SSL=false

# Alternatively, one URL that overrides the TIDB_* values above:
# TEST_DATABASE_URL=mysql://user:password@host:4000/it_asset_ledger_test

# Test-only secrets. Generate fresh ones; never reuse the production values.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
AUDIT_HMAC_KEY=
TOTP_ENCRYPTION_KEY=

# bcrypt cost (minimum allowed is 12)
BCRYPT_ROUNDS=12
