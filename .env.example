# ============================================================================
# OmniAsset Enterprise IT Asset Management - Production Environment Variables
# ============================================================================

# Security Session & Signing Secret (Generate 32+ random hex characters)
SESSION_SECRET="generate-a-strong-random-32-byte-hex-secret"

# PingCAP TiDB Cloud Configuration (Server-Side ONLY)
# Console: https://tidbcloud.com -> Connect -> General
TIDB_HOST=<your-cluster-host>.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=it_asset_ledger
TIDB_SSL=true

# Initial Administrator Provisioning (Used by bootstrap & maintenance scripts)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=generate-a-strong-admin-password

# In-Memory Database Mode (Optional: set to 'true' for offline dev/testing without TiDB Cloud)
ALLOW_IN_MEMORY_DB=false
