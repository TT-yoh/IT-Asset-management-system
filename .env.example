# ============================================================================
# OmniAsset Enterprise IT Asset Management - Environment Configuration
# ============================================================================
# Copy this file to .env and provide your deployment-specific configuration.
# Leave no placeholders in production. All credentials below are empty.
# ============================================================================

# Application Environment ('development', 'production', or 'test')
# Secure by default: unset defaults to 'production'. Set explicitly in your environment.
NODE_ENV=development

# Server API Port (default: 3001)
PORT=3001

# Session Signing & Cookie Secret (REQUIRED in production)
# Must be 64 hex characters or base64 of >=32 random bytes with high entropy.
# Generate via: openssl rand -hex 32
SESSION_SECRET=

# Previous Session Secret for zero-downtime key rotation (Optional)
# Supports verifying sessions signed with the previous key during rollover.
SESSION_SECRET_PREVIOUS=

# Session TTL in seconds (default: 3600 = 1 hour; min: 300, max: 86400)
SESSION_TTL_SECONDS=3600

# Bcrypt password hashing cost rounds (default: 12, min: 12)
BCRYPT_ROUNDS=12

# Database Connection Pool Limit (default: 3 on Vercel, 10 otherwise)
DB_POOL_LIMIT=10

# PingCAP TiDB Cloud / MySQL Server Configuration (Server-Side ONLY)
# REQUIRED in production.
# TiDB Cloud Console -> Connect -> General
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=
TIDB_SSL=true

# Path to custom CA certificate file (Optional, e.g., /etc/ssl/certs/ca-certificates.crt)
TIDB_CA_PATH=

# Allowed CORS Origins (Comma-separated list of origins)
# REQUIRED in production (e.g., https://assets.example.com,https://admin.example.com)
# In development, defaults to localhost:3000, localhost:3001
CORS_ORIGINS=

# TOTP 2FA Encryption Key (AES-256-GCM symmetric key for encrypting TOTP secrets)
# REQUIRED in production. Must be 64 hex characters or base64 of >=32 random bytes.
# Generate via: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Cryptographic Audit HMAC Key (SHA-256 HMAC key for append-only audit trail verification)
# REQUIRED in production. Must be 64 hex characters or base64 of >=32 random bytes, distinct from SESSION_SECRET.
# Generate via: openssl rand -hex 32
AUDIT_HMAC_KEY=

# Audit Anchoring (Periodic state sink)
AUDIT_ANCHOR_ENABLED=false
AUDIT_ANCHOR_SINK=none
AUDIT_ANCHOR_PATH=
AUDIT_ANCHOR_WEBHOOK_URL=

# Reverse Proxy Trust Setting (Optional)
# Set to 'false' (default), hop count integer (e.g. '1' for Vercel/Cloudflare), or comma-separated CIDR list
# NEVER bare 'true' in production unless explicitly intending to trust all upstream proxies
TRUST_PROXY=false

# Strictly require Idempotency-Key headers on all mutating POST/PUT/PATCH requests
IDEMPOTENCY_REQUIRED=false

# In-Memory Database Mode (Automated Testing ONLY; refused if NODE_ENV != test)
ALLOW_IN_MEMORY_DB=false

# SMTP Mail Delivery Settings (Optional: for password resets & 2FA invitation delivery)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# MAIL_FROM is the sender address (falls back to MAIL_USER). Port 465 uses implicit TLS;
# any other port uses STARTTLS, which is mandatory in production.
# Without MAIL_HOST and a sender, reset and invitation emails are NOT sent (a warning is logged).

# Public URL of the web app, used for links in emails (e.g. https://assets.example.com).
# Falls back to the first CORS_ORIGINS entry when empty.
APP_BASE_URL=
